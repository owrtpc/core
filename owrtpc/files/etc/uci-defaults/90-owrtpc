#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

if ! uci -q show firewall | grep -q "path='/usr/share/owrtpc/firewall.include'"; then
	uci add firewall include >/dev/null
	uci set firewall.@include[-1].type='script'
	uci set firewall.@include[-1].path='/usr/share/owrtpc/firewall.include'
	uci set firewall.@include[-1].fw4_compatible='1'
	uci commit firewall
fi

# Releases up to r11 used 1 KiB per sample, which treats normal standby
# telemetry as screen time. Migrate only the old shipped default so explicit
# administrator choices remain untouched.
activity_threshold=$(uci -q get owrtpc.main.activity_threshold_bytes)
if [ -z "$activity_threshold" ] || [ "$activity_threshold" = '1024' ]; then
	uci set owrtpc.main.activity_threshold_bytes='131072'
	uci commit owrtpc
fi

# r25 gives allowances and bedtime independent, explicit day ranges. Copy the
# old values once, then remove them so clearing a new field cannot reveal a
# stale compatibility fallback later.
migrate_period_option() {
	section="$1"
	new_option="$2"
	compatibility_option="$3"
	legacy_option="$4"
	default_value="$5"
	value=$(uci -q get "owrtpc.$section.$new_option")
	if [ -z "$value" ]; then
		value=$(uci -q get "owrtpc.$section.$compatibility_option")
	fi
	if [ -z "$value" ]; then
		value=$(uci -q get "owrtpc.$section.$legacy_option")
	fi
	[ -n "$value" ] || value="$default_value"
	[ -z "$value" ] || uci set "owrtpc.$section.$new_option=$value"
}

for profile in $(uci -q show owrtpc | sed -n 's/^owrtpc\.\([^=]*\)=profile$/\1/p'); do
	migrate_period_option "$profile" mon_thu_daily_minutes weekday_daily_minutes daily_minutes 0
	migrate_period_option "$profile" fri_sun_daily_minutes weekend_daily_minutes daily_minutes 0
	migrate_period_option "$profile" sun_thu_bedtime_start weekday_bedtime_start bedtime_start ''
	migrate_period_option "$profile" sun_thu_bedtime_end weekday_bedtime_end bedtime_end ''
	migrate_period_option "$profile" fri_sat_bedtime_start weekend_bedtime_start bedtime_start ''
	migrate_period_option "$profile" fri_sat_bedtime_end weekend_bedtime_end bedtime_end ''
	for old_option in daily_minutes weekday_daily_minutes weekend_daily_minutes \
		bedtime_start bedtime_end weekday_bedtime_start weekday_bedtime_end \
		weekend_bedtime_start weekend_bedtime_end; do
		uci -q delete "owrtpc.$profile.$old_option"
	done
done
uci commit owrtpc

/etc/init.d/owrtpc enable
exit 0
