. /usr/share/libubox/jshn.sh
. /lib/functions.sh
. /usr/share/owrtpc/lock.sh

OWRTPCCTL=/usr/sbin/owrtpcctl

safe_profile() {
	case "$1" in
		''|*[!A-Za-z0-9_\-]*) return 1 ;;
		*) [ "$(uci -q get "owrtpc.$1")" = 'profile' ] ;;
	esac
}

config_revision() {
	uci -q export owrtpc 2>/dev/null | sha256sum | cut -d' ' -f1
}

valid_time() {
	printf '%s\n' "$1" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$'
}

valid_bedtime_pair() {
	[ -z "$1$2" ] || { valid_time "$1" && valid_time "$2"; }
}

normalize_mac() {
	printf '%s' "$1" | tr 'abcdef' 'ABCDEF'
}

valid_mac() {
	printf '%s\n' "$1" | grep -Eq '^[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}$'
}

rpc_error() {
	json_init
	json_add_boolean success 0
	json_add_string error "$1"
	json_dump
}

# Serialize quick writes with reset, including their UCI edits. The engine
# lock separately protects samples/checkpoints and allows these calls to use
# owrtpcctl without taking the same lock twice.
rpc_write() (
	owrtpc_lock "$OWRTPC_ACTION_LOCK" || { rpc_error 'OWRTPC is busy'; exit 0; }
	trap 'rmdir "$OWRTPC_ACTION_LOCK"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	"$@"
)

rpc_reset() {
	json_load "$1" || { rpc_error 'Invalid JSON request'; return; }
	json_get_var confirmation confirmation
	json_get_type confirmation_type confirmation
	[ "$confirmation_type" = string ] && [ "$confirmation" = 'RESET OWRTPC' ] || {
		rpc_error 'Explicit confirmation is required: RESET OWRTPC'
		return
	}
	message_file=$(mktemp /tmp/owrtpc-rpc-reset.XXXXXX) || return 1
	if "$OWRTPCCTL" reset --confirm > "$message_file" 2>&1; then
		json_init; json_add_boolean success 1; json_dump
	else
		rpc_error "$(cat "$message_file")"
	fi
	rm -f "$message_file"
}

rpc_status() {
	status_file=$(mktemp /tmp/owrtpc-rpc-status.XXXXXX) || return 1
	diagnostics_file=$(mktemp /tmp/owrtpc-rpc-diagnostics.XXXXXX) || {
		rm -f "$status_file"
		return 1
	}
	if ! "$OWRTPCCTL" status > "$status_file"; then
		rm -f "$status_file" "$diagnostics_file"
		rpc_error 'Unable to read OWRTPC status'
		return
	fi
	if ! "$OWRTPCCTL" diagnostics > "$diagnostics_file"; then
		rm -f "$status_file" "$diagnostics_file"
		rpc_error 'Unable to read OWRTPC device usage'
		return
	fi
	json_init
	json_add_string date "$(date +%F)"
	json_add_array profiles
	tab=$(printf '\t')
	{
		IFS= read -r _header
		while IFS="$tab" read -r section name used limit remaining reason manual schedule bonus all_day allowance_period bedtime_period; do
			[ -n "$section" ] || continue
			json_add_object ''
			json_add_string section "$section"
			json_add_string name "$name"
			json_add_int used_seconds "${used:-0}"
			json_add_int limit_seconds "${limit:-0}"
			json_add_int remaining_seconds "${remaining:-0}"
			json_add_string reason "${reason:-none}"
			json_add_boolean manual_blocked "${manual:-0}"
			json_add_string schedule "${schedule:-weekday}"
			json_add_string allowance_period "${allowance_period:-mon_thu}"
			json_add_string bedtime_period "${bedtime_period:-sun_thu}"
			json_add_int bonus_seconds "${bonus:-0}"
			json_add_boolean all_day "${all_day:-0}"
			case "$reason" in none|disabled) json_add_boolean blocked 0 ;; *) json_add_boolean blocked 1 ;; esac
			json_add_array devices
			{
				IFS= read -r _diagnostics_header
				while IFS="$tab" read -r device_profile _device_name device_mac device_used _activity_state _candidate _quiet _last_bytes _last_significant _last_sample; do
					[ "$device_profile" = "$section" ] || continue
					json_add_object ''
					json_add_string mac "$device_mac"
					json_add_int used_seconds "${device_used:-0}"
					json_close_object
				done
			} < "$diagnostics_file"
			json_close_array
			json_close_object
		done
	} < "$status_file"
	json_close_array
	json_dump
	rm -f "$status_file" "$diagnostics_file"
}

snapshot_device() {
	json_add_string '' "$(normalize_mac "$1")"
}

snapshot_profile() {
	section="$1"
	config_get name "$section" name "$section"
	config_get_bool enabled "$section" enabled 1
	config_get_bool blocked "$section" blocked 0
	config_get mon_thu "$section" mon_thu_daily_minutes ''
	[ -n "$mon_thu" ] || config_get mon_thu "$section" weekday_daily_minutes ''
	[ -n "$mon_thu" ] || config_get mon_thu "$section" daily_minutes 0
	config_get fri_sun "$section" fri_sun_daily_minutes ''
	[ -n "$fri_sun" ] || config_get fri_sun "$section" weekend_daily_minutes ''
	[ -n "$fri_sun" ] || config_get fri_sun "$section" daily_minutes 0
	config_get sun_start "$section" sun_thu_bedtime_start ''
	[ -n "$sun_start" ] || config_get sun_start "$section" weekday_bedtime_start ''
	[ -n "$sun_start" ] || config_get sun_start "$section" bedtime_start ''
	config_get sun_end "$section" sun_thu_bedtime_end ''
	[ -n "$sun_end" ] || config_get sun_end "$section" weekday_bedtime_end ''
	[ -n "$sun_end" ] || config_get sun_end "$section" bedtime_end ''
	config_get fri_start "$section" fri_sat_bedtime_start ''
	[ -n "$fri_start" ] || config_get fri_start "$section" weekend_bedtime_start ''
	[ -n "$fri_start" ] || config_get fri_start "$section" bedtime_start ''
	config_get fri_end "$section" fri_sat_bedtime_end ''
	[ -n "$fri_end" ] || config_get fri_end "$section" weekend_bedtime_end ''
	[ -n "$fri_end" ] || config_get fri_end "$section" bedtime_end ''
	config_get threshold "$section" activity_threshold_bytes 0

	json_add_object ''
	json_add_string section "$section"
	json_add_string name "$name"
	json_add_boolean enabled "$enabled"
	json_add_boolean blocked "$blocked"
	json_add_int mon_thu_daily_minutes "${mon_thu:-0}"
	json_add_int fri_sun_daily_minutes "${fri_sun:-0}"
	json_add_string sun_thu_bedtime_start "$sun_start"
	json_add_string sun_thu_bedtime_end "$sun_end"
	json_add_string fri_sat_bedtime_start "$fri_start"
	json_add_string fri_sat_bedtime_end "$fri_end"
	json_add_int activity_threshold_bytes "${threshold:-0}"
	json_add_array devices
	config_list_foreach "$section" device snapshot_device
	json_close_array
	json_close_object
}

rpc_edit_snapshot() {
	config_load owrtpc
	json_init
	json_add_string revision "$(config_revision)"
	json_add_array profiles
	config_foreach snapshot_profile profile
	json_close_array
	json_dump
}

rpc_profile_apply_error() {
	json_init
	json_add_boolean success 0
	json_add_string code "$1"
	json_add_string error "$2"
	json_dump
}

PROFILE_APPLY_SECTION=''
PROFILE_APPLY_DEVICES=''
PROFILE_APPLY_CONFLICT=''

check_assigned_device() {
	device=$(normalize_mac "$1")
	grep -Fqx -- "$device" "$PROFILE_APPLY_DEVICES" 2>/dev/null &&
		PROFILE_APPLY_CONFLICT="$device"
}

check_other_profile() {
	[ "$1" = "$PROFILE_APPLY_SECTION" ] ||
		config_list_foreach "$1" device check_assigned_device
}

restore_profile_config() {
	cp "$1" /etc/config/owrtpc
	"$OWRTPCCTL" apply >/dev/null 2>&1 || true
}

set_bedtime_options() {
	section="$1"
	period="$2"
	start="$3"
	end="$4"
	if [ -n "$start" ]; then
		uci set "owrtpc.$section.${period}_bedtime_start=$start"
		uci set "owrtpc.$section.${period}_bedtime_end=$end"
	else
		uci -q delete "owrtpc.$section.${period}_bedtime_start" || true
		uci -q delete "owrtpc.$section.${period}_bedtime_end" || true
	fi
}

rpc_profile_write() (
	mode="$1"
	request="$2"
	json_load "$request" || { rpc_profile_apply_error invalid_request 'Invalid JSON request'; return; }
	json_get_var expected_revision expected_revision
	json_get_var section section
	json_get_var name name
	json_get_var enabled enabled
	json_get_var mon_thu mon_thu_daily_minutes
	json_get_var fri_sun fri_sun_daily_minutes
	json_get_var sun_start sun_thu_bedtime_start
	json_get_var sun_end sun_thu_bedtime_end
	json_get_var fri_start fri_sat_bedtime_start
	json_get_var fri_end fri_sat_bedtime_end
	json_get_var threshold activity_threshold_bytes
	json_get_type devices_type devices

	case "$expected_revision" in
		*[!0-9a-f]*|'') rpc_profile_apply_error invalid_request 'Invalid configuration revision'; return ;;
	esac
	[ "${#expected_revision}" -eq 64 ] || {
		rpc_profile_apply_error invalid_request 'Invalid configuration revision'; return
	}
	case "$mode" in
		update) safe_profile "$section" || { rpc_profile_apply_error not_found 'Unknown profile'; return; } ;;
		create) section='' ;;
		*) rpc_profile_apply_error invalid_request 'Invalid profile operation'; return ;;
	esac
	[ -n "$name" ] && [ "${#name}" -le 80 ] || {
		rpc_profile_apply_error validation_failed 'Profile name is required and must not exceed 80 characters'; return
	}
	case "$enabled" in 1|true) enabled=1 ;; 0|false) enabled=0 ;;
		*) rpc_profile_apply_error validation_failed 'enabled must be a boolean'; return ;;
	esac
	case "$mon_thu" in ''|*[!0-9]*) rpc_profile_apply_error validation_failed 'Invalid Monday-Thursday allowance'; return ;; esac
	case "$fri_sun" in ''|*[!0-9]*) rpc_profile_apply_error validation_failed 'Invalid Friday-Sunday allowance'; return ;; esac
	valid_bedtime_pair "$sun_start" "$sun_end" || {
		rpc_profile_apply_error validation_failed 'Incomplete or invalid Sunday-Thursday bedtime'; return
	}
	valid_bedtime_pair "$fri_start" "$fri_end" || {
		rpc_profile_apply_error validation_failed 'Incomplete or invalid Friday-Saturday bedtime'; return
	}
	case "$threshold" in ''|*[!0-9]*) rpc_profile_apply_error validation_failed 'Invalid activity threshold'; return ;; esac
	[ "$threshold" -eq 0 ] || [ "$threshold" -gt 0 ] || {
		rpc_profile_apply_error validation_failed 'Invalid activity threshold'; return
	}
	[ "$devices_type" = array ] || {
		rpc_profile_apply_error validation_failed 'devices must be an array'; return
	}

	devices_file=$(mktemp /tmp/owrtpc-rpc-devices.XXXXXX) || return 1
	backup_file=$(mktemp /tmp/owrtpc-rpc-config.XXXXXX) || { rm -f "$devices_file"; return 1; }
	trap 'rm -f "$devices_file" "$backup_file"' EXIT
	json_select devices
	json_get_keys device_keys
	for key in $device_keys; do
		json_get_var device "$key"
		device=$(normalize_mac "$device")
		valid_mac "$device" || {
			rpc_profile_apply_error validation_failed 'Invalid device MAC address'; return
		}
		grep -Fqx -- "$device" "$devices_file" 2>/dev/null && {
			rpc_profile_apply_error validation_failed 'A device is listed more than once'; return
		}
		printf '%s\n' "$device" >> "$devices_file"
	done
	json_select ..

	current_revision=$(config_revision)
	[ "$current_revision" = "$expected_revision" ] || {
		rpc_profile_apply_error conflicting_edit 'The OWRTPC configuration changed after this draft was opened'; return
	}
	PROFILE_APPLY_SECTION="$section"
	PROFILE_APPLY_DEVICES="$devices_file"
	PROFILE_APPLY_CONFLICT=''
	config_load owrtpc
	config_foreach check_other_profile profile
	[ -z "$PROFILE_APPLY_CONFLICT" ] || {
		rpc_profile_apply_error validation_failed "Device $PROFILE_APPLY_CONFLICT is assigned to another profile"; return
	}

	cp /etc/config/owrtpc "$backup_file" || return 1
	"$OWRTPCCTL" sample >/dev/null 2>&1 || true
	if [ "$mode" = create ]; then
		section=$(uci add owrtpc profile) || {
			rpc_profile_apply_error apply_failed 'Unable to create the profile'
			return
		}
		uci set "owrtpc.$section.blocked=0"
	fi
	uci set "owrtpc.$section.name=$name"
	uci set "owrtpc.$section.enabled=$enabled"
	uci set "owrtpc.$section.mon_thu_daily_minutes=$mon_thu"
	uci set "owrtpc.$section.fri_sun_daily_minutes=$fri_sun"
	uci -q delete "owrtpc.$section.device" || true
	while IFS= read -r device; do
		uci add_list "owrtpc.$section.device=$device"
	done < "$devices_file"
	for option in daily_minutes weekday_daily_minutes weekend_daily_minutes \
		bedtime_start bedtime_end weekday_bedtime_start weekday_bedtime_end \
		weekend_bedtime_start weekend_bedtime_end; do
		uci -q delete "owrtpc.$section.$option" || true
	done
	set_bedtime_options "$section" sun_thu "$sun_start" "$sun_end"
	set_bedtime_options "$section" fri_sat "$fri_start" "$fri_end"
	if [ "$threshold" -eq 0 ]; then
		uci -q delete "owrtpc.$section.activity_threshold_bytes" || true
	else
		uci set "owrtpc.$section.activity_threshold_bytes=$threshold"
	fi
	uci commit owrtpc

	if ! "$OWRTPCCTL" validate >/dev/null 2>&1; then
		restore_profile_config "$backup_file"
		rpc_profile_apply_error validation_failed 'The router rejected the complete profile configuration'
		return
	fi
	if ! "$OWRTPCCTL" apply; then
		restore_profile_config "$backup_file"
		rpc_profile_apply_error apply_failed 'Policy refresh failed and the previous configuration was restored'
		return
	fi
	json_init
	json_add_boolean success 1
	json_add_string section "$section"
	json_add_string revision "$(config_revision)"
	json_dump
)

rpc_profile_apply() {
	rpc_profile_write update "$1"
}

rpc_profile_create() {
	rpc_profile_write create "$1"
}

rpc_profile_delete() (
	json_load "$1" || { rpc_profile_apply_error invalid_request 'Invalid JSON request'; return; }
	json_get_var expected_revision expected_revision
	json_get_var section section
	case "$expected_revision" in
		*[!0-9a-f]*|'') rpc_profile_apply_error invalid_request 'Invalid configuration revision'; return ;;
	esac
	[ "${#expected_revision}" -eq 64 ] || {
		rpc_profile_apply_error invalid_request 'Invalid configuration revision'; return
	}
	# Never commit changes staged by another local client.
	[ -z "$(uci -q changes owrtpc)" ] && [ "$(config_revision)" = "$expected_revision" ] || {
		rpc_profile_apply_error conflicting_edit 'The OWRTPC configuration changed before deletion'; return
	}
	safe_profile "$section" || { rpc_profile_apply_error not_found 'Unknown profile'; return; }
	transaction_dir=$(mktemp -d /tmp/owrtpc-rpc-delete.XXXXXX) || return 1
	trap 'rm -rf "$transaction_dir"' EXIT
	cp /etc/config/owrtpc "$transaction_dir/config" || return 1
	"$OWRTPCCTL" sample >/dev/null 2>&1 || true
	if uci -t "$transaction_dir" delete "owrtpc.$section" &&
		uci -t "$transaction_dir" commit owrtpc &&
		"$OWRTPCCTL" validate >/dev/null 2>&1 &&
		"$OWRTPCCTL" apply >/dev/null 2>&1; then
		# Forget only this removed profile's counters, under the engine lock.
		# Device diagnostics and all other profiles retain their usage.
		"$OWRTPCCTL" forget-profile "$section" || {
			rpc_profile_apply_error outcome_unknown 'Profile removed but state cleanup could not be confirmed'; return
		}
		json_init
		json_add_boolean success 1
		json_add_string section "$section"
		json_add_string revision "$(config_revision)"
		json_dump
	elif cp "$transaction_dir/config" /etc/config/owrtpc &&
		"$OWRTPCCTL" apply >/dev/null 2>&1; then
		rpc_profile_apply_error apply_failed 'Deletion failed and the previous configuration and policy were restored'
	else
		rpc_profile_apply_error outcome_unknown 'Deletion failed and restoration could not be confirmed'
	fi
)

rpc_capabilities() {
	package_owner=$(apk info --who-owns "$OWRTPCCTL" 2>/dev/null |
		sed -n 's/^.* is owned by //p' | head -n 1)
	case "$package_owner" in
		owrtpc-*) backend_version=${package_owner#owrtpc-} ;;
		*) backend_version=development ;;
	esac
	router_timezone=$(uci -q get 'system.@system[0].zonename')
	[ -n "$router_timezone" ] || router_timezone=$(date +%Z)

	json_init
	json_add_string api 'owrtpc-mobile'
	json_add_int major 1
	json_add_int minor 5
	json_add_string backend_version "$backend_version"
	json_add_array features
	json_add_string '' 'profiles.read'
	json_add_string '' 'profiles.write'
	json_add_string '' 'quick-actions'
	json_add_string '' 'device-discovery'
	json_add_string '' 'uci-apply-confirm'
	json_add_string '' 'schedule-periods'
	json_add_string '' 'device-usage'
	json_add_string '' 'profile-edit-transaction'
	json_add_string '' 'profile-create-transaction'
	json_add_string '' 'profile-delete-transaction'
	json_close_array
	json_add_string router_date "$(date +%F)"
	json_add_string router_timezone "$router_timezone"
	json_dump
}

rpc_set_enabled() {
	json_load "$1" || { rpc_error 'Invalid JSON request'; return; }
	json_get_var profile profile
	json_get_var enabled enabled
	safe_profile "$profile" || { rpc_error 'Unknown profile'; return; }
	case "$enabled" in
		1|true) value=1 ;;
		0|false) value=0 ;;
		*) rpc_error 'enabled must be a boolean'; return ;;
	esac
	"$OWRTPCCTL" sample >/dev/null 2>&1 || true
	uci set "owrtpc.$profile.enabled=$value"
	uci commit owrtpc
	if "$OWRTPCCTL" apply; then
		json_init
		json_add_boolean success 1
		json_add_boolean enabled "$value"
		json_dump
	else
		rpc_error 'Policy refresh failed'
	fi
}

rpc_set_block() {
	json_load "$1" || { rpc_error 'Invalid JSON request'; return; }
	json_get_var profile profile
	json_get_var blocked blocked
	safe_profile "$profile" || { rpc_error 'Unknown profile'; return; }
	case "$blocked" in
		1|true) value=1 ;;
		0|false) value=0 ;;
		*) rpc_error 'blocked must be a boolean'; return ;;
	esac
	"$OWRTPCCTL" sample >/dev/null 2>&1 || true
	uci set "owrtpc.$profile.blocked=$value"
	uci commit owrtpc
	if "$OWRTPCCTL" apply; then
		json_init; json_add_boolean success 1; json_dump
	else
		rpc_error 'Policy refresh failed'
	fi
}

rpc_add_time() {
	json_load "$1" || { rpc_error 'Invalid JSON request'; return; }
	json_get_var profile profile
	json_get_var minutes minutes
	safe_profile "$profile" || { rpc_error 'Unknown profile'; return; }
	case "$minutes" in
		60) seconds=3600 ;;
		240) seconds=14400 ;;
		all-day) seconds=all-day ;;
		*) rpc_error 'Unsupported time increment'; return ;;
	esac
	"$OWRTPCCTL" sample >/dev/null 2>&1 || true
	"$OWRTPCCTL" add-time "$profile" "$seconds"
	result=$?
	case "$result" in
		0)
			json_init
			json_add_boolean success 1
			if [ "$seconds" = 'all-day' ]; then
				json_add_boolean all_day 1
			else
				json_add_int added_seconds "$seconds"
			fi
			json_dump
			;;
		2) rpc_error 'Bedtime is active; extra time was not added' ;;
		3) rpc_error 'This profile already has unlimited time' ;;
		*) rpc_error 'Unable to add extra time' ;;
	esac
}

rpc_refresh() {
	if "$OWRTPCCTL" apply; then
		json_init; json_add_boolean success 1; json_dump
	else
		rpc_error 'Policy refresh failed'
	fi
}

rpc_validate() {
	message_file=$(mktemp /tmp/owrtpc-rpc-validate.XXXXXX) || return 1
	"$OWRTPCCTL" validate > "$message_file" 2>&1
	result=$?
	json_init
	[ "$result" -eq 0 ] && json_add_boolean valid 1 || json_add_boolean valid 0
	json_add_array messages
	while IFS= read -r line; do
		[ -n "$line" ] && json_add_string '' "$line"
	done < "$message_file"
	json_close_array
	json_dump
	rm -f "$message_file"
}

case "$1" in
	list)
		json_init
		json_add_object capabilities; json_close_object
		json_add_object status; json_close_object
		json_add_object edit_snapshot; json_close_object
		json_add_object profile_apply
		json_add_string expected_revision String
		json_add_string section String
		json_add_string name String
		json_add_string enabled Boolean
		json_add_string mon_thu_daily_minutes Int32
		json_add_string fri_sun_daily_minutes Int32
		json_add_string sun_thu_bedtime_start String
		json_add_string sun_thu_bedtime_end String
		json_add_string fri_sat_bedtime_start String
		json_add_string fri_sat_bedtime_end String
		json_add_string activity_threshold_bytes Int32
		json_add_array devices; json_close_array
		json_close_object
		json_add_object profile_create
		json_add_string expected_revision String
		json_add_string name String
		json_add_string enabled Boolean
		json_add_string mon_thu_daily_minutes Int32
		json_add_string fri_sun_daily_minutes Int32
		json_add_string sun_thu_bedtime_start String
		json_add_string sun_thu_bedtime_end String
		json_add_string fri_sat_bedtime_start String
		json_add_string fri_sat_bedtime_end String
		json_add_string activity_threshold_bytes Int32
		json_add_array devices; json_close_array
		json_close_object
		json_add_object profile_delete
		json_add_string expected_revision String
		json_add_string section String
		json_close_object
		json_add_object set_enabled
		json_add_string profile String
		json_add_string enabled Boolean
		json_close_object
		json_add_object set_block
		json_add_string profile String
		json_add_string blocked Boolean
		json_close_object
		json_add_object add_time
		json_add_string profile String
		json_add_string minutes Int32
		json_close_object
		json_add_object refresh; json_close_object
		json_add_object validate; json_close_object
		json_add_object reset
		json_add_string confirmation String
		json_close_object
		json_dump
		;;
	call)
		read -r request
		case "$2" in
			capabilities) rpc_capabilities ;;
			status) rpc_status ;;
			edit_snapshot) rpc_write rpc_edit_snapshot ;;
			profile_apply) rpc_write rpc_profile_apply "$request" ;;
			profile_create) rpc_write rpc_profile_create "$request" ;;
			profile_delete) rpc_write rpc_profile_delete "$request" ;;
			set_enabled) rpc_write rpc_set_enabled "$request" ;;
			set_block) rpc_write rpc_set_block "$request" ;;
			add_time) rpc_write rpc_add_time "$request" ;;
			refresh) rpc_write rpc_refresh ;;
			validate) rpc_validate ;;
			reset) rpc_reset "$request" ;;
			*) rpc_error 'Unknown method' ;;
		esac
		;;
esac
