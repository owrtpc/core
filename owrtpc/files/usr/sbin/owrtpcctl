#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

UCI_BIN="${OWRTPC_UCI_BIN:-uci}"
NFT_BIN="${OWRTPC_NFT_BIN:-nft}"
UBUS_BIN="${OWRTPC_UBUS_BIN:-ubus}"
JSONFILTER_BIN="${OWRTPC_JSONFILTER_BIN:-jsonfilter}"
STATE_DIR="${OWRTPC_STATE_DIR:-/tmp/owrtpc}"
PERSIST_DIR="${OWRTPC_PERSIST_DIR:-/etc/owrtpc/state}"
FUNCTIONS_LIB="${OWRTPC_FUNCTIONS_LIB:-/lib/functions.sh}"

if [ ! -r "$FUNCTIONS_LIB" ]; then
	echo "owrtpcctl: missing $FUNCTIONS_LIB" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$FUNCTIONS_LIB"

log() {
	logger -t owrtpc -- "$*" 2>/dev/null || printf '%s\n' "$*" >&2
}

safe_id() {
	case "$1" in
		''|*[!A-Za-z0-9_\-]*) return 1 ;;
		*) return 0 ;;
	esac
}

normalize_mac() {
	printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

valid_mac() {
	printf '%s\n' "$1" | grep -Eq '^[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}$'
}

valid_time() {
	printf '%s\n' "$1" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$'
}

time_minutes() {
	value="$1"
	hour=${value%:*}
	minute=${value#*:}
	# Strip leading zeroes without relying on non-POSIX base prefixes.
	hour=$(printf '%s' "$hour" | sed 's/^0//')
	minute=$(printf '%s' "$minute" | sed 's/^0//')
	[ -n "$hour" ] || hour=0
	[ -n "$minute" ] || minute=0
	printf '%s\n' $((hour * 60 + minute))
}

is_bedtime() {
	start="$1"
	end="$2"
	now_minutes="$3"
	valid_time "$start" || return 1
	valid_time "$end" || return 1
	start_minutes=$(time_minutes "$start")
	end_minutes=$(time_minutes "$end")
	[ "$start_minutes" -ne "$end_minutes" ] || return 1

	if [ "$start_minutes" -lt "$end_minutes" ]; then
		[ "$now_minutes" -ge "$start_minutes" ] && [ "$now_minutes" -lt "$end_minutes" ]
	else
		[ "$now_minutes" -ge "$start_minutes" ] || [ "$now_minutes" -lt "$end_minutes" ]
	fi
}

current_day_of_week() {
	day_of_week="${OWRTPC_DAY_OF_WEEK:-$(date +%u)}"
	case "$day_of_week" in
		1|2|3|4|5|6|7) printf '%s\n' "$day_of_week" ;;
		*) return 1 ;;
	esac
}

previous_day_of_week() {
	case "$1" in
		1) printf '7\n' ;;
		2|3|4|5|6|7) printf '%s\n' $(($1 - 1)) ;;
		*) return 1 ;;
	esac
}

allowance_period_for_day() {
	case "$1" in
		1|2|3|4) printf 'mon_thu\n' ;;
		5|6|7) printf 'fri_sun\n' ;;
		*) return 1 ;;
	esac
}

bedtime_period_for_day() {
	case "$1" in
		7|1|2|3|4) printf 'sun_thu\n' ;;
		5|6) printf 'fri_sat\n' ;;
		*) return 1 ;;
	esac
}

current_allowance_period() {
	allowance_period_for_day "$(current_day_of_week)"
}

# Kept for status/API compatibility. It now describes the allowance group.
current_schedule() {
	case "$(current_allowance_period)" in
		mon_thu) printf 'weekday\n' ;;
		fri_sun) printf 'weekend\n' ;;
	esac
}

profile_schedule_value() {
	profile="$1"
	schedule="$2"
	option="$3"
	legacy_option="$4"
	default="$5"
	value=''
	config_get value "$profile" "${schedule}_${option}" ''
	if [ -z "$value" ]; then
		config_get value "$profile" "$legacy_option" "$default"
	fi
	printf '%s\n' "$value"
}

profile_period_value() {
	profile="$1"
	period="$2"
	compatibility_schedule="$3"
	option="$4"
	legacy_option="$5"
	default="$6"
	value=''
	config_get value "$profile" "${period}_${option}" ''
	if [ -z "$value" ]; then
		value=$(profile_schedule_value "$profile" "$compatibility_schedule" "$option" "$legacy_option" "$default")
	fi
	printf '%s\n' "$value"
}

profile_allowance_value() {
	profile="$1"
	period="$2"
	case "$period" in
		mon_thu) compatibility_schedule=weekday ;;
		fri_sun) compatibility_schedule=weekend ;;
		*) return 1 ;;
	esac
	profile_period_value "$profile" "$period" "$compatibility_schedule" daily_minutes daily_minutes 0
}

profile_bedtime_value() {
	profile="$1"
	period="$2"
	option="$3"
	case "$period" in
		sun_thu) compatibility_schedule=weekday ;;
		fri_sat) compatibility_schedule=weekend ;;
		*) return 1 ;;
	esac
	profile_period_value "$profile" "$period" "$compatibility_schedule" "$option" "$option" ''
}

ensure_state() {
	umask 077
	mkdir -p "$STATE_DIR" "$PERSIST_DIR"
	today=$(date +%F)
	state_date=''
	[ -r "$STATE_DIR/date" ] && state_date=$(sed -n '1p' "$STATE_DIR/date")

	if [ "$state_date" != "$today" ]; then
		for state_file in "$STATE_DIR"/profile-*.used "$STATE_DIR"/profile-*.bonus "$STATE_DIR"/profile-*.all_day "$STATE_DIR"/device-*.used "$STATE_DIR"/device-*.activity-* "$STATE_DIR"/device-*.diagnostic-*; do
			[ -e "$state_file" ] && rm -f "$state_file"
		done
		printf '%s\n' "$today" > "$STATE_DIR/date"
		printf '0\n' > "$STATE_DIR/last_sample"
	fi
}

restore_state() {
	ensure_state
	today=$(date +%F)
	persist_date=''
	[ -r "$PERSIST_DIR/date" ] && persist_date=$(sed -n '1p' "$PERSIST_DIR/date")
	[ "$persist_date" = "$today" ] || return 0

	for state_file in "$PERSIST_DIR"/profile-*.used "$PERSIST_DIR"/profile-*.bonus "$PERSIST_DIR"/profile-*.all_day "$PERSIST_DIR"/device-*.used; do
		[ -e "$state_file" ] || continue
		cp "$state_file" "$STATE_DIR/$(basename "$state_file")"
	done
}

checkpoint_state() {
	ensure_state
	today=$(date +%F)
	printf '%s\n' "$today" > "$PERSIST_DIR/date.tmp"
	mv "$PERSIST_DIR/date.tmp" "$PERSIST_DIR/date"
	for old_file in "$PERSIST_DIR"/profile-*.used "$PERSIST_DIR"/profile-*.bonus "$PERSIST_DIR"/profile-*.all_day "$PERSIST_DIR"/device-*.used; do
		[ -e "$old_file" ] && rm -f "$old_file"
	done
	for state_file in "$STATE_DIR"/profile-*.used "$STATE_DIR"/profile-*.bonus "$STATE_DIR"/profile-*.all_day "$STATE_DIR"/device-*.used; do
		[ -e "$state_file" ] || continue
		base=$(basename "$state_file")
		cp "$state_file" "$PERSIST_DIR/$base.tmp"
		mv "$PERSIST_DIR/$base.tmp" "$PERSIST_DIR/$base"
	done
	date +%s > "$STATE_DIR/last_checkpoint"
}

get_used() {
	profile="$1"
	safe_id "$profile" || { printf '0\n'; return; }
	used=0
	[ -r "$STATE_DIR/profile-$profile.used" ] && used=$(sed -n '1p' "$STATE_DIR/profile-$profile.used")
	case "$used" in ''|*[!0-9]*) used=0 ;; esac
	printf '%s\n' "$used"
}

set_used() {
	profile="$1"
	used="$2"
	safe_id "$profile" || return 1
	printf '%s\n' "$used" > "$STATE_DIR/profile-$profile.used.tmp"
	mv "$STATE_DIR/profile-$profile.used.tmp" "$STATE_DIR/profile-$profile.used"
}

device_state_id() {
	local mac
	mac=$(normalize_mac "$1")
	valid_mac "$mac" || return 1
	printf '%s\n' "$mac" | tr -d ':'
}

get_device_used() {
	local id used
	id=$(device_state_id "$1") || { printf '0\n'; return; }
	used=0
	[ -r "$STATE_DIR/device-$id.used" ] && used=$(sed -n '1p' "$STATE_DIR/device-$id.used")
	case "$used" in ''|*[!0-9]*) used=0 ;; esac
	printf '%s\n' "$used"
}

set_device_used() {
	local id used
	id=$(device_state_id "$1") || return 1
	used="$2"
	printf '%s\n' "$used" > "$STATE_DIR/device-$id.used.tmp"
	mv "$STATE_DIR/device-$id.used.tmp" "$STATE_DIR/device-$id.used"
}

get_bonus() {
	profile="$1"
	safe_id "$profile" || { printf '0\n'; return; }
	bonus=0
	[ -r "$STATE_DIR/profile-$profile.bonus" ] && bonus=$(sed -n '1p' "$STATE_DIR/profile-$profile.bonus")
	case "$bonus" in ''|*[!0-9]*) bonus=0 ;; esac
	printf '%s\n' "$bonus"
}

set_bonus() {
	profile="$1"
	bonus="$2"
	safe_id "$profile" || return 1
	printf '%s\n' "$bonus" > "$STATE_DIR/profile-$profile.bonus.tmp"
	mv "$STATE_DIR/profile-$profile.bonus.tmp" "$STATE_DIR/profile-$profile.bonus"
}

clear_bonus() {
	profile="$1"
	safe_id "$profile" || return 1
	rm -f "$STATE_DIR/profile-$profile.bonus"
}

get_all_day() {
	profile="$1"
	safe_id "$profile" || { printf '0\n'; return; }
	all_day=0
	[ -r "$STATE_DIR/profile-$profile.all_day" ] && all_day=$(sed -n '1p' "$STATE_DIR/profile-$profile.all_day")
	[ "$all_day" = '1' ] || all_day=0
	printf '%s\n' "$all_day"
}

set_all_day() {
	profile="$1"
	safe_id "$profile" || return 1
	printf '1\n' > "$STATE_DIR/profile-$profile.all_day.tmp"
	mv "$STATE_DIR/profile-$profile.all_day.tmp" "$STATE_DIR/profile-$profile.all_day"
}

clear_all_day() {
	profile="$1"
	safe_id "$profile" || return 1
	rm -f "$STATE_DIR/profile-$profile.all_day"
}

discard_time_credit() {
	profile="$1"
	safe_id "$profile" || return 1
	clear_bonus "$profile"
	clear_all_day "$profile"
	rm -f "$PERSIST_DIR/profile-$profile.bonus" "$PERSIST_DIR/profile-$profile.all_day"
}

replace_time_credit() {
	profile="$1"
	seconds="$2"
	safe_id "$profile" || return 1
	if [ "$seconds" = 'all-day' ]; then
		clear_bonus "$profile"
		set_all_day "$profile"
	else
		clear_all_day "$profile"
		set_bonus "$profile" "$seconds"
	fi
}

replace_remaining_time() {
	profile="$1"
	base_limit="$2"
	seconds="$3"
	safe_id "$profile" || return 1
	case "$base_limit:$seconds" in
		*[!0-9:]*|:*|*:) return 1 ;;
	esac
	used=$(get_used "$profile")
	target_limit=$((used + seconds))
	[ "$target_limit" -ge "$base_limit" ] || target_limit="$base_limit"
	replace_time_credit "$profile" $((target_limit - base_limit))
}

profile_bedtime_continues_from_previous_day() {
	profile="$1"
	day_of_week=$(current_day_of_week)
	previous_day=$(previous_day_of_week "$day_of_week")
	period=$(bedtime_period_for_day "$previous_day")
	bedtime_start=$(profile_bedtime_value "$profile" "$period" bedtime_start)
	bedtime_end=$(profile_bedtime_value "$profile" "$period" bedtime_end)
	valid_time "$bedtime_start" || return 1
	valid_time "$bedtime_end" || return 1
	start_minutes=$(time_minutes "$bedtime_start")
	end_minutes=$(time_minutes "$bedtime_end")
	[ "$start_minutes" -gt "$end_minutes" ] || return 1
	now_hhmm="${OWRTPC_NOW_HHMM:-$(date +%H:%M)}"
	[ "$(time_minutes "$now_hhmm")" -lt "$end_minutes" ]
}

profile_bedtime_starts_today() {
	profile="$1"
	period=$(bedtime_period_for_day "$(current_day_of_week)")
	bedtime_start=$(profile_bedtime_value "$profile" "$period" bedtime_start)
	bedtime_end=$(profile_bedtime_value "$profile" "$period" bedtime_end)
	valid_time "$bedtime_start" || return 1
	valid_time "$bedtime_end" || return 1
	start_minutes=$(time_minutes "$bedtime_start")
	end_minutes=$(time_minutes "$bedtime_end")
	[ "$start_minutes" -ne "$end_minutes" ] || return 1
	now_hhmm="${OWRTPC_NOW_HHMM:-$(date +%H:%M)}"
	now_minutes=$(time_minutes "$now_hhmm")
	if [ "$start_minutes" -lt "$end_minutes" ]; then
		[ "$now_minutes" -ge "$start_minutes" ] && [ "$now_minutes" -lt "$end_minutes" ]
	else
		[ "$now_minutes" -ge "$start_minutes" ]
	fi
}

profile_bedtime_period() {
	profile="$1"
	if profile_bedtime_continues_from_previous_day "$profile"; then
		previous_day=$(previous_day_of_week "$(current_day_of_week)")
		bedtime_period_for_day "$previous_day"
	else
		bedtime_period_for_day "$(current_day_of_week)"
	fi
}

profile_bedtime_active() {
	profile="$1"
	profile_bedtime_continues_from_previous_day "$profile" ||
		profile_bedtime_starts_today "$profile"
}

profile_reason() {
	profile="$1"
	config_get_bool profile_enabled "$profile" enabled 1
	[ "$profile_enabled" -eq 1 ] || { printf 'disabled\n'; return; }

	if profile_bedtime_active "$profile"; then
		discard_time_credit "$profile"
		printf 'bedtime\n'
		return
	fi

	config_get_bool manually_blocked "$profile" blocked 0
	if [ "$manually_blocked" -eq 1 ]; then
		printf 'manual\n'
		return
	fi

	if [ "$(get_all_day "$profile")" -eq 1 ]; then
		printf 'none\n'
		return
	fi

	allowance_period=$(current_allowance_period)
	daily_minutes=$(profile_allowance_value "$profile" "$allowance_period")
	case "$daily_minutes" in ''|*[!0-9]*) daily_minutes=0 ;; esac
	used=$(get_used "$profile")
	bonus=$(get_bonus "$profile")
	if [ "$daily_minutes" -gt 0 ] && [ "$used" -ge $((daily_minutes * 60 + bonus)) ]; then
		printf 'quota\n'
		return
	fi

	printf 'none\n'
}

VALIDATE_ERRORS=0
VALIDATE_SEEN=''

validation_error() {
	VALIDATE_ERRORS=$((VALIDATE_ERRORS + 1))
	printf 'ERROR\t%s\n' "$*"
}

validate_device() {
	device="$1"
	profile="$2"
	mac=$(normalize_mac "$device")
	if ! valid_mac "$mac"; then
		validation_error "profile $profile has invalid MAC address: $device"
		return
	fi
	previous=$(awk -F '\t' -v mac="$mac" '$1 == mac { print $2; exit }' "$VALIDATE_SEEN")
	if [ -n "$previous" ] && [ "$previous" != "$profile" ]; then
		validation_error "MAC $mac is assigned to both $previous and $profile"
	else
		printf '%s\t%s\n' "$mac" "$profile" >> "$VALIDATE_SEEN"
	fi
}

validate_profile() {
	profile="$1"
	config_get profile_threshold "$profile" activity_threshold_bytes ''
	case "$profile_threshold" in
		'') ;;
		*[!0-9]*|0) validation_error "profile $profile has invalid activity_threshold_bytes" ;;
	esac
	for allowance_period in mon_thu fri_sun; do
		daily_minutes=$(profile_allowance_value "$profile" "$allowance_period")
		case "$daily_minutes" in
			''|*[!0-9]*) validation_error "profile $profile has invalid ${allowance_period}_daily_minutes" ;;
		esac
	done
	for bedtime_period in sun_thu fri_sat; do
		start=$(profile_bedtime_value "$profile" "$bedtime_period" bedtime_start)
		end=$(profile_bedtime_value "$profile" "$bedtime_period" bedtime_end)
		if { [ -n "$start" ] || [ -n "$end" ]; } && { ! valid_time "$start" || ! valid_time "$end"; }; then
			validation_error "profile $profile has an incomplete or invalid $bedtime_period bedtime"
		fi
	done
	config_list_foreach "$profile" device validate_device "$profile"
}

validate_config() {
	config_load owrtpc
	VALIDATE_ERRORS=0
	config_get main_threshold main activity_threshold_bytes 131072
	case "$main_threshold" in
		''|*[!0-9]*|0) validation_error 'main has invalid activity_threshold_bytes' ;;
	esac
	config_get confirm_window main activity_confirm_window 300
	case "$confirm_window" in
		''|*[!0-9]*|0) validation_error 'main has invalid activity_confirm_window' ;;
	esac
	config_get idle_timeout main activity_idle_timeout 180
	case "$idle_timeout" in
		''|*[!0-9]*|0) validation_error 'main has invalid activity_idle_timeout' ;;
	esac
	VALIDATE_SEEN=$(mktemp "$STATE_DIR/validate.XXXXXX") || return 1
	config_foreach validate_profile profile
	rm -f "$VALIDATE_SEEN"
	if [ "$VALIDATE_ERRORS" -eq 0 ]; then
		printf 'OK\n'
		return 0
	fi
	return 1
}

append_unique() {
	line="$1"
	file="$2"
	grep -Fqx -- "$line" "$file" 2>/dev/null || printf '%s\n' "$line" >> "$file"
}

APPLY_SEEN=''
APPLY_BLOCKS=''
APPLY_COUNTERS=''

apply_device() {
	device="$1"
	profile="$2"
	reason="$3"
	mac=$(normalize_mac "$device")
	valid_mac "$mac" || return
	previous=$(awk -F '\t' -v mac="$mac" '$1 == mac { print $2; exit }' "$APPLY_SEEN")
	if [ -n "$previous" ] && [ "$previous" != "$profile" ]; then
		while IFS= read -r output_device; do
			[ -n "$output_device" ] || continue
			append_unique "add rule inet owrtpc forward oifname \"$output_device\" ether saddr $mac drop comment \"owrtpc-duplicate:$mac\"" "$APPLY_BLOCKS"
		done < "$APPLY_OUTPUT_DEVICES"
		return
	fi
	printf '%s\t%s\n' "$mac" "$profile" >> "$APPLY_SEEN"
	[ "$reason" != 'disabled' ] || return
	while IFS= read -r output_device; do
		[ -n "$output_device" ] || continue
		match="oifname \"$output_device\" ether saddr $mac"
		if [ "$reason" != 'none' ]; then
			append_unique "add rule inet owrtpc forward $match drop comment \"owrtpc-block:$reason:$mac\"" "$APPLY_BLOCKS"
		else
			append_unique "add rule inet owrtpc forward $match counter comment \"owrtpc-device:$mac\"" "$APPLY_COUNTERS"
		fi
	done < "$APPLY_OUTPUT_DEVICES"
}

apply_profile() {
	profile="$1"
	reason=$(profile_reason "$profile")
	[ "$reason" != 'disabled' ] || return 0
	config_list_foreach "$profile" device apply_device "$profile" "$reason"
}

resolve_output_network() {
	network="$1"
	case "$network" in ''|*[!A-Za-z0-9_\-]*) return ;; esac
	device=$("$UBUS_BIN" -S call "network.interface.$network" status 2>/dev/null |
		"$JSONFILTER_BIN" -e '@.l3_device' 2>/dev/null)
	case "$device" in ''|*[!A-Za-z0-9_.:@\-]*) return ;; esac
	append_unique "$device" "$APPLY_OUTPUT_DEVICES"
}

resolve_output_device() {
	device="$1"
	case "$device" in ''|*[!A-Za-z0-9_.:@\-]*) return ;; esac
	append_unique "$device" "$APPLY_OUTPUT_DEVICES"
}

apply_policy() {
	ensure_state
	config_load owrtpc
	config_get_bool engine_enabled main enabled 1

	work_dir=$(mktemp -d "$STATE_DIR/apply.XXXXXX") || return 1
	APPLY_SEEN="$work_dir/seen"
	APPLY_BLOCKS="$work_dir/blocks"
	APPLY_COUNTERS="$work_dir/counters"
	APPLY_OUTPUT_DEVICES="$work_dir/output-devices"
	: > "$APPLY_SEEN"
	: > "$APPLY_BLOCKS"
	: > "$APPLY_COUNTERS"
	: > "$APPLY_OUTPUT_DEVICES"
	config_list_foreach main monitored_network resolve_output_network
	config_list_foreach main monitored_device resolve_output_device
	if [ ! -s "$APPLY_OUTPUT_DEVICES" ]; then
		log 'no monitored output network is currently available'
	fi
	[ "$engine_enabled" -eq 0 ] || config_foreach apply_profile profile

	rules="$work_dir/rules.nft"
	{
		# Replace the table in one transaction, including during reset/startup.
		# Unlike delete, destroy also works when no previous table exists.
		printf 'destroy table inet owrtpc\n'
		printf 'add table inet owrtpc\n'
		printf 'add chain inet owrtpc forward { type filter hook forward priority -5; policy accept; }\n'
		cat "$APPLY_BLOCKS"
		cat "$APPLY_COUNTERS"
	} > "$rules"

	if ! "$NFT_BIN" -f "$rules"; then
		log 'failed to install nftables policy'
		rm -rf "$work_dir"
		return 1
	fi
	rm -rf "$work_dir"
}

COUNTERS_FILE=''
SAMPLE_ELAPSED=0
SAMPLE_NOW=0
SAMPLE_THRESHOLD=131072
SAMPLE_PROFILE_THRESHOLD=131072
ACTIVITY_CONFIRM_WINDOW=300
ACTIVITY_IDLE_TIMEOUT=180

activity_path() {
	local mac="$1"
	local key="$2"
	local id
	id=$(device_state_id "$mac") || return 1
	printf '%s/device-%s.activity-%s\n' "$STATE_DIR" "$id" "$key"
}

diagnostic_path() {
	local id
	id=$(device_state_id "$1") || return 1
	printf '%s/device-%s.diagnostic-%s\n' "$STATE_DIR" "$id" "$2"
}

diagnostic_read() {
	local path value
	path=$(diagnostic_path "$1" "$2") || { printf '0\n'; return; }
	value=0
	[ -r "$path" ] && value=$(sed -n '1p' "$path")
	case "$value" in ''|*[!0-9]*) value=0 ;; esac
	printf '%s\n' "$value"
}

diagnostic_write() {
	local path
	path=$(diagnostic_path "$1" "$2") || return 1
	printf '%s\n' "$3" > "$path.tmp"
	mv "$path.tmp" "$path"
}

activity_log() {
	log "$@"
}

activity_read() {
	local path value
	path=$(activity_path "$1" "$2")
	value=0
	[ -r "$path" ] && value=$(sed -n '1p' "$path")
	case "$value" in ''|*[!0-9]*) value=0 ;; esac
	printf '%s\n' "$value"
}

activity_write() {
	local path
	path=$(activity_path "$1" "$2")
	printf '%s\n' "$3" > "$path.tmp"
	mv "$path.tmp" "$path"
}

activity_remove() {
	local path
	path=$(activity_path "$1" "$2")
	rm -f "$path"
}

clear_device_activity() {
	local mac
	mac=$(normalize_mac "$1")
	valid_mac "$mac" || return
	activity_remove "$mac" candidate_started
	activity_remove "$mac" candidate_elapsed
	activity_remove "$mac" active
	activity_remove "$mac" quiet_elapsed
}

start_activity_candidate() {
	local mac="$1"
	local profile="$2"
	local bytes="$3"
	clear_device_activity "$mac"
	activity_write "$mac" candidate_started "$SAMPLE_NOW"
	activity_write "$mac" candidate_elapsed "$SAMPLE_ELAPSED"
	activity_log "activity candidate profile=$profile device=$mac bytes=$bytes"
}

add_profile_usage() {
	local profile="$1"
	local mac="$2"
	local elapsed="$3"
	local current device_current
	[ "$elapsed" -gt 0 ] || return
	current=$(get_used "$profile")
	set_used "$profile" $((current + elapsed))
	device_current=$(get_device_used "$mac")
	set_device_used "$mac" $((device_current + elapsed))
}

counter_bytes() {
	local mac="$1"
	awk -F '\t' -v mac="$mac" '$1 == mac { total += $2 } END { print total + 0 }' "$COUNTERS_FILE"
}

sample_device() {
	local device="$1"
	local profile="$2"
	local mac bytes significant active candidate_started candidate_elapsed age quiet_elapsed
	mac=$(normalize_mac "$device")
	valid_mac "$mac" || return
	bytes=$(counter_bytes "$mac")
	case "$bytes" in ''|*[!0-9]*) bytes=0 ;; esac
	if [ "$bytes" -ge "$SAMPLE_PROFILE_THRESHOLD" ]; then
		significant=1
	else
		significant=0
	fi
	diagnostic_write "$mac" last_bytes "$bytes"
	diagnostic_write "$mac" last_significant "$significant"
	diagnostic_write "$mac" last_sample "$SAMPLE_NOW"

	active=$(activity_read "$mac" active)
	if [ "$active" -eq 1 ]; then
		quiet_elapsed=$(activity_read "$mac" quiet_elapsed)
		if [ "$significant" -eq 1 ]; then
			add_profile_usage "$profile" "$mac" $((quiet_elapsed + SAMPLE_ELAPSED))
			activity_remove "$mac" quiet_elapsed
		else
			quiet_elapsed=$((quiet_elapsed + SAMPLE_ELAPSED))
			if [ "$quiet_elapsed" -ge "$ACTIVITY_IDLE_TIMEOUT" ]; then
				activity_log "activity stopped profile=$profile device=$mac discarded_quiet_seconds=$quiet_elapsed"
				clear_device_activity "$mac"
			else
				activity_write "$mac" quiet_elapsed "$quiet_elapsed"
			fi
		fi
		return
	fi

	candidate_started=$(activity_read "$mac" candidate_started)
	if [ "$candidate_started" -eq 0 ]; then
		[ "$significant" -eq 0 ] || start_activity_candidate "$mac" "$profile" "$bytes"
		return
	fi

	age=$((SAMPLE_NOW - candidate_started))
	if [ "$age" -ge "$ACTIVITY_CONFIRM_WINDOW" ]; then
		clear_device_activity "$mac"
		[ "$significant" -eq 0 ] || start_activity_candidate "$mac" "$profile" "$bytes"
		return
	fi

	candidate_elapsed=$(activity_read "$mac" candidate_elapsed)
	candidate_elapsed=$((candidate_elapsed + SAMPLE_ELAPSED))
	if [ "$significant" -eq 1 ]; then
		add_profile_usage "$profile" "$mac" "$candidate_elapsed"
		clear_device_activity "$mac"
		activity_write "$mac" active 1
		activity_log "activity started profile=$profile device=$mac accounted_seconds=$candidate_elapsed bytes=$bytes"
	else
		activity_write "$mac" candidate_elapsed "$candidate_elapsed"
	fi
}

sample_profile() {
	local profile="$1"
	local profile_enabled allowance_period daily_minutes reason
	config_get_bool profile_enabled "$profile" enabled 1
	if [ "$profile_enabled" -ne 1 ]; then
		config_list_foreach "$profile" device clear_device_activity
		return
	fi

	allowance_period=$(current_allowance_period)
	daily_minutes=$(profile_allowance_value "$profile" "$allowance_period")
	case "$daily_minutes" in ''|*[!0-9]*) daily_minutes=0 ;; esac
	if [ "$daily_minutes" -eq 0 ]; then
		config_list_foreach "$profile" device clear_device_activity
		return
	fi

	reason=$(profile_reason "$profile")
	if [ "$reason" != 'none' ]; then
		config_list_foreach "$profile" device clear_device_activity
		return
	fi

	config_get SAMPLE_PROFILE_THRESHOLD "$profile" activity_threshold_bytes "$SAMPLE_THRESHOLD"
	case "$SAMPLE_PROFILE_THRESHOLD" in ''|*[!0-9]*|0) SAMPLE_PROFILE_THRESHOLD="$SAMPLE_THRESHOLD" ;; esac
	config_list_foreach "$profile" device sample_device "$profile"
}

read_counters() {
	COUNTERS_FILE="$1"
	: > "$COUNTERS_FILE"
	"$NFT_BIN" list chain inet owrtpc forward 2>/dev/null |
		sed -n 's/.*bytes \([0-9][0-9]*\).*comment "owrtpc-device:\([0-9A-Fa-f:]*\)".*/\2\t\1/p' |
		tr '[:lower:]' '[:upper:]' > "$COUNTERS_FILE"
}

sample_usage() {
	ensure_state
	config_load owrtpc
	config_get sample_interval main sample_interval 60
	config_get SAMPLE_THRESHOLD main activity_threshold_bytes 131072
	config_get ACTIVITY_CONFIRM_WINDOW main activity_confirm_window 300
	config_get ACTIVITY_IDLE_TIMEOUT main activity_idle_timeout 180
	case "$sample_interval" in ''|*[!0-9]*|0) sample_interval=60 ;; esac
	case "$SAMPLE_THRESHOLD" in ''|*[!0-9]*|0) SAMPLE_THRESHOLD=131072 ;; esac
	case "$ACTIVITY_CONFIRM_WINDOW" in ''|*[!0-9]*|0) ACTIVITY_CONFIRM_WINDOW=300 ;; esac
	case "$ACTIVITY_IDLE_TIMEOUT" in ''|*[!0-9]*|0) ACTIVITY_IDLE_TIMEOUT=180 ;; esac

	now=$(date +%s)
	SAMPLE_NOW="$now"
	last=0
	[ -r "$STATE_DIR/last_sample" ] && last=$(sed -n '1p' "$STATE_DIR/last_sample")
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	if [ "$last" -eq 0 ]; then
		SAMPLE_ELAPSED="$sample_interval"
	else
		SAMPLE_ELAPSED=$((now - last))
		[ "$SAMPLE_ELAPSED" -gt 0 ] || SAMPLE_ELAPSED="$sample_interval"
		max_elapsed=$((sample_interval * 2))
		[ "$SAMPLE_ELAPSED" -le "$max_elapsed" ] || SAMPLE_ELAPSED="$max_elapsed"
	fi

	COUNTERS_FILE=$(mktemp "$STATE_DIR/counters.XXXXXX") || return 1
	read_counters "$COUNTERS_FILE"
	config_foreach sample_profile profile
	rm -f "$COUNTERS_FILE"
	printf '%s\n' "$now" > "$STATE_DIR/last_sample"

	apply_policy || return 1
	config_get checkpoint_interval main checkpoint_interval 900
	case "$checkpoint_interval" in ''|*[!0-9]*|0) checkpoint_interval=900 ;; esac
	last_checkpoint=0
	[ -r "$STATE_DIR/last_checkpoint" ] && last_checkpoint=$(sed -n '1p' "$STATE_DIR/last_checkpoint")
	case "$last_checkpoint" in ''|*[!0-9]*) last_checkpoint=0 ;; esac
	[ $((now - last_checkpoint)) -lt "$checkpoint_interval" ] || checkpoint_state
}

status_profile() {
	profile="$1"
	config_get name "$profile" name "$profile"
	allowance_period=$(current_allowance_period)
	schedule=$(current_schedule)
	bedtime_period=$(profile_bedtime_period "$profile")
	daily_minutes=$(profile_allowance_value "$profile" "$allowance_period")
	case "$daily_minutes" in ''|*[!0-9]*) daily_minutes=0 ;; esac
	used=$(get_used "$profile")
	reason=$(profile_reason "$profile")
	bonus=$(get_bonus "$profile")
	all_day=$(get_all_day "$profile")
	limit=$((daily_minutes * 60))
	if [ "$all_day" -eq 1 ]; then
		limit=0
	else
		[ "$limit" -eq 0 ] || limit=$((limit + bonus))
	fi
	remaining=0
	[ "$limit" -eq 0 ] || {
		remaining=$((limit - used))
		[ "$remaining" -ge 0 ] || remaining=0
	}
	config_get_bool manual "$profile" blocked 0
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$profile" "$name" "$used" "$limit" "$remaining" "$reason" "$manual" "$schedule" "$bonus" "$all_day" "$allowance_period" "$bedtime_period"
}

status_all() {
	ensure_state
	config_load owrtpc
	printf 'section\tname\tused_seconds\tlimit_seconds\tremaining_seconds\treason\tmanual_blocked\tschedule\tbonus_seconds\tall_day\tallowance_period\tbedtime_period\n'
	config_foreach status_profile profile
}

diagnostics_device() {
	device="$1"
	profile="$2"
	mac=$(normalize_mac "$device")
	valid_mac "$mac" || return
	used=$(get_device_used "$mac")
	active=$(activity_read "$mac" active)
	candidate_started=$(activity_read "$mac" candidate_started)
	candidate_elapsed=$(activity_read "$mac" candidate_elapsed)
	quiet_elapsed=$(activity_read "$mac" quiet_elapsed)
	last_bytes=$(diagnostic_read "$mac" last_bytes)
	last_significant=$(diagnostic_read "$mac" last_significant)
	last_sample=$(diagnostic_read "$mac" last_sample)
	if [ "$active" -eq 1 ]; then
		state=active
	elif [ "$candidate_started" -gt 0 ]; then
		state=candidate
	else
		state=idle
	fi
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$profile" "$DIAGNOSTICS_PROFILE_NAME" "$mac" "$used" "$state" "$candidate_elapsed" "$quiet_elapsed" "$last_bytes" "$last_significant" "$last_sample"
}

diagnostics_profile() {
	profile="$1"
	config_get DIAGNOSTICS_PROFILE_NAME "$profile" name "$profile"
	config_list_foreach "$profile" device diagnostics_device "$profile"
}

diagnostics_all() {
	ensure_state
	config_load owrtpc
	printf 'profile\tname\tdevice\tused_seconds\tactivity_state\tcandidate_seconds\tquiet_seconds\tlast_bytes\tlast_significant\tlast_sample_epoch\n'
	config_foreach diagnostics_profile profile
}

add_time() {
	profile="$1"
	seconds="$2"
	safe_id "$profile" || return 1
	case "$seconds" in 3600|14400|all-day) ;; *) return 1 ;; esac
	ensure_state
	config_load owrtpc
	if profile_bedtime_active "$profile"; then
		discard_time_credit "$profile"
		checkpoint_state
		return 2
	fi
	allowance_period=$(current_allowance_period)
	daily_minutes=$(profile_allowance_value "$profile" "$allowance_period")
	case "$daily_minutes" in ''|*[!0-9]*|0) return 3 ;; esac
	if [ "$seconds" = 'all-day' ]; then
		replace_time_credit "$profile" "$seconds"
	else
		replace_remaining_time "$profile" $((daily_minutes * 60)) "$seconds"
	fi
	checkpoint_state
	apply_policy
}

initialize() {
	restore_state
	ensure_state
	date +%s > "$STATE_DIR/last_sample"
	apply_policy
}

if [ "${OWRTPC_TEST_MODE:-0}" = '1' ]; then
	return 0 2>/dev/null || exit 0
fi

if [ "${1:-}" = reset ]; then
	shift
	exec /usr/libexec/owrtpc-reset "$@"
fi

. /usr/share/owrtpc/lock.sh
owrtpc_lock "$OWRTPC_ENGINE_LOCK" || exit 1
trap 'rmdir "$OWRTPC_ENGINE_LOCK"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
ensure_state

case "${1:-}" in
	apply) apply_policy ;;
	checkpoint) checkpoint_state ;;
	init) initialize ;;
	sample) sample_usage ;;
	status) status_all ;;
	diagnostics) diagnostics_all ;;
	add-time) add_time "${2:-}" "${3:-}" ;;
	validate) ensure_state; validate_config ;;
	*)
		echo "Usage: owrtpcctl {init|sample|apply|status|diagnostics|validate|checkpoint|add-time PROFILE SECONDS|reset --confirm}" >&2
		exit 2
		;;
esac
